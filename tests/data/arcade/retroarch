#!/bin/sh
# RetroArch as far as the Arcade module starts it (tests/arcade_test.cpp): it
# notes its arguments, the folder it runs in and the controller database it is
# given in $MAME_LOG, copies the config it was started with to $RA_CONFIG_COPY,
# and logs (--log-file) what RetroArch with FinalBurn Neo would: the game
# started, but files missing for mslug and 1943 and a set it doesn't know for
# galaga,
# a sign-in refused for the password "wrong" or the token "expired", and
# RetroAchievements not reached for the token "offline". It swaps the password
# "secret" for a token in the config, as RetroArch saves it on exit, and takes
# $RA_SECONDS to end.
#
# Started with OSD/OS's sign-in core, to check a sign-in, it says on its
# output what RetroArch's log does as it signs in, its token in the config
# first, as it would save it on exit: signed in for the password "secret",
# refused for "wrong", RetroAchievements not reached for "offline", nothing
# for "silent", signed in with no token kept for "notoken", and for "later"
# not reached until $RA_ONLINE is there, then signed in (the network up a
# while after OSD/OS starts); and runs until it is stopped.
#
# Asked its version, it says it as a recent RetroArch prints it, and does
# nothing else.
if [ "$1" = "--version" ]; then
	echo "RetroArch - Frontend for libretro"
	echo "Version: 1.22.2 (Git c4f8f5f) Oct 20 2026"
	exit 0
fi
log=""; config=""; content=""; prev=""
for a in "$@"; do
	case "$a" in --log-file=*) log="${a#--log-file=}" ;; esac
	[ "$prev" = "--config" ] && config="$a"
	prev="$a"; content="$a"
done
{
	echo "retroarch $*"
	echo "cwd $(pwd)"
	echo "sdlconfig ${SDL_GAMECONTROLLERCONFIG_FILE:-}"
	echo "xdg ${XDG_CONFIG_HOME:-}"
} >> "$MAME_LOG"
cp "$config" "$RA_CONFIG_COPY"
case "$2" in
*osdos_signin_libretro*)
	user=$(sed -n 's/^cheevos_username = "\(.*\)"$/\1/p' "$config")
	echo "[INFO] RetroArch 1.20.0 (Git c4f8f5f)"
	if grep -q 'cheevos_password = "secret"' "$config"; then
		sed -i 's/^cheevos_token = .*/cheevos_token = "tok789"/; s/^cheevos_password = .*/cheevos_password = ""/' "$config"
		echo "[INFO] [RCHEEVOS]: $user logged in successfully"
	elif grep -q 'cheevos_password = "wrong"' "$config"; then
		echo "[INFO] [RCHEEVOS]: Login failed: Invalid User/Password combination. Please try again"
		echo "[INFO] [RCHEEVOS]: RetroAchievements login failed: Invalid User/Password combination. Please try again"
	elif grep -q 'cheevos_password = "offline"' "$config"; then
		echo "[INFO] [RCHEEVOS]: RetroAchievements login failed: No response from server"
	elif grep -q 'cheevos_password = "notoken"' "$config"; then
		echo "[INFO] [RCHEEVOS]: $user logged in successfully"
	elif grep -q 'cheevos_password = "later"' "$config"; then
		if [ -n "$RA_ONLINE" ] && [ -e "$RA_ONLINE" ]; then
			sed -i 's/^cheevos_token = .*/cheevos_token = "tok456"/; s/^cheevos_password = .*/cheevos_password = ""/' "$config"
			echo "[INFO] [RCHEEVOS]: $user logged in successfully"
		else
			echo "[INFO] [RCHEEVOS]: RetroAchievements login failed: No response from server"
		fi
	fi
	echo "[INFO] [RCHEEVOS]: Game not recognized, pausing hardcore"
	trap 'kill $! 2>/dev/null; exit 0' TERM
	sleep 30 &
	wait
	exit 0
	;;
esac
game=$(basename "$content"); game="${game%.*}"
{
	echo "[INFO] RetroArch 1.20.0 (Git c4f8f5f)"
	case "$game" in
	mslug)
		echo "[libretro ERROR] [FBNeo] ROM at index 1 with name 201-p1.p1 and CRC 0x12345678 is required"
		echo "[libretro ERROR] [FBNeo] ROM at index 2 with name 201-s1.s1 and CRC 0x2345678a is required"
		echo "[libretro ERROR] [FBNeo] None of those archives was found in your paths"
		;;
	1943)
		echo "[libretro ERROR] [FBNeo] ROM at index 0 with name bme01.12d and CRC 0x55fd447e is required"
		;;
	galaga) ;;
	*) echo "[libretro INFO] [FBNeo] Driver successfully started" ;;
	esac
	grep -q 'cheevos_password = "wrong"' "$config" \
		&& echo "[INFO] [RCHEEVOS]: RetroAchievements login failed: Invalid User/Password combination. Please try again"
	grep -q 'cheevos_token = "expired"' "$config" \
		&& echo "[INFO] [RCHEEVOS]: RetroAchievements login failed: Invalid token"
	grep -q 'cheevos_token = "offline"' "$config" \
		&& echo "[INFO] [RCHEEVOS]: RetroAchievements login failed: No response from server"
} > "$log"
[ -n "$RA_SECONDS" ] && sleep "$RA_SECONDS"
if grep -q 'cheevos_password = "secret"' "$config"; then
	sed -i 's/^cheevos_token = .*/cheevos_token = "tok123"/; s/^cheevos_password = .*/cheevos_password = ""/' "$config"
fi
exit 0
