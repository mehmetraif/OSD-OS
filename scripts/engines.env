# The programs OSD/OS plays arcade games with, at the same versions on every
# machine, so that machines play together over the network and take the same
# sets. Each is the lowest version that every distribution of OSD/OS can
# have, and all of them rise together when that floor rises
# (.github/workflows/engines.yml opens the pull request). Read by the build
# scripts, the workflows and CMake, which gives the versions to the app.
#
# FinalBurn Neo: the commit that both of OSD/OS's FinalBurn Neo cores are
# built from, and its date (yymmdd), which the cores' version is made of.
# The whole core goes in every package (scripts/build-fbneo.sh), and so does
# the CV1000 LAN core (scripts/build-fbneo-lan.sh), whose patch is made
# against this commit.
FBNEO_COMMIT=77016b4dff6c76beba08d24ea1c61ed2750bc0a7
FBNEO_DATE=261108
# RetroArch and MAME: the versions in the OSD/OS image, Debian trixie's
# packages, the lowest that any distribution has. OSD/OS downloads these
# versions where nothing else installs them (Windows:
# src/modules/arcade/ProgramInstaller.cpp).
RETROARCH_VERSION=1.20.0
MAME_VERSION=0.276
# RetroArch's commit at that version's tag (v1.20.0), which the Linux arm64
# package's own RetroArch is built from, with TLS (scripts/build-retroarch.sh):
# Debian's is built without, and asks RetroAchievements over plain HTTP.
RETROARCH_COMMIT=ab3b175848fa6cd8b2340809631e30bc0fe1d136
