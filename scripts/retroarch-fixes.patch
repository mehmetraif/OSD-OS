+   client_num &= ~NETPLAY_CMD_SYNC_BIT_PAUSED;
+   if (client_num == 0 || client_num >= MAX_CLIENTS)
    {
-      netplay->remote_paused = true;
-      client_num ^= NETPLAY_CMD_SYNC_BIT_PAUSED;
