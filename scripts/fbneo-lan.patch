+// OSD/OS's LAN build: from power on, the machine waits in its reset with its
+// video memory empty until player 2 presses something. That memory isn't in
+// netplay's states (epic12_scan()), so a machine joining a game already under
+// way would draw from what it holds of its own: waiting until both machines
+// are in it, the game starts on each at the same frame and fills it alike.
+// nCv1kLanLateJoin: this machine joined one already started (libretro.cpp
+// says so on screen).
+INT32 nCv1kLanWaiting = 0;
+INT32 nCv1kLanLateJoin = 0;
+
 static struct BurnInputInfo Cv1kInputList[] = {
 	{"P1 Coin",			BIT_DIGITAL,	DrvJoy1 + 2,	"p1 coin"	},
 	{"P1 Start",		BIT_DIGITAL,	DrvJoy1 + 4,	"p1 start"	},
@@ -529,6 +539,10 @@ static INT32 DrvInit()
 	ymz770_set_buffered(Sh3TotalCycles, SH3_CLOCK);
 	DrvDoReset();
 
+	nCv1kLanWaiting = 1;
+	nCv1kLanLateJoin = 0;
+	bprintf(PRINT_UI, _T("OSD/OS LAN: waiting for player 2 to start the game\n"));
+
 	return 0;
 }
 
@@ -546,6 +560,9 @@ static INT32 DrvExit()
 
 	is_type_d = 0;
 
+	nCv1kLanWaiting = 0;
+	nCv1kLanLateJoin = 0;
+
 	return 0;
 }
 
@@ -610,6 +627,31 @@ static INT32 DrvFrame()
 		hold_coin.checklow(1, DrvInputs[0], 1<<3, 2);
 	}
 
+	// OSD/OS's LAN build: while it waits (nCv1kLanWaiting) nothing runs, the
+	// screen is black and silent. Player 2's first button, coin or start starts
+	// the game from its reset, which empties the video memory again for a
+	// rollback that replays this frame.
+	if (nCv1kLanWaiting) {
+		UINT8 player2 = DrvJoy1[3] | DrvJoy1[5];
+		for (INT32 i = 0; i < 8; i++) {
+			player2 |= DrvJoy4[i];
+		}
+
+		if (!player2) {
+			if (pBurnSoundOut) {
+				memset(pBurnSoundOut, 0, nBurnSoundLen * 2 * sizeof(INT16));
+			}
+			if (pBurnDraw) {
+				BurnDrvRedraw();
+			}
+			return 0;
+		}
+
+		nCv1kLanWaiting = 0;
+		bprintf(PRINT_UI, _T("OSD/OS LAN: player 2 starts the game at frame %d\n"), nCurrentFrame);
+		DrvDoReset();
+	}
+
 	Sh3NewFrame();
 
 	INT32 nInterleave = 240;
@@ -666,6 +708,14 @@ static INT32 DrvScan(INT32 nAction, INT32 *pnMin)
 		SCAN_VAR(nExtraCycles);
 
 		hold_coin.scan();
+
+		// OSD/OS's LAN build: a netplay state of a game started, loaded while
+		// this machine still waits, is that of a game it joins late.
+		INT32 waiting = nCv1kLanWaiting;
+		SCAN_VAR(nCv1kLanWaiting);
+		if ((nAction & ACB_WRITE) && (nAction & ACB_NET_OPT) && waiting && !nCv1kLanWaiting) {
+			nCv1kLanLateJoin = 1;
+		}
 	}
 
 	serflash_scan(nAction, pnMin); // writes back to flash (hiscores ddpdfk, etc) here
