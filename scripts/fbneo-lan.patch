+// OSD/OS's LAN build: the game's players are seated in the order they come
+// in. Netplay's port 0, the host's player 1, is player 1; any other port sits
+// as the first free player when it first presses COIN or START, and drives
+// that player from then on, so that a controller no one plays holds no
+// player. The seats are in the core's states (LibretroAreaScan()): every
+// machine seats alike, through a rollback too.
+INT32 nLanSeat[MAX_PLAYERS];
+UINT32 nLanSeatsAnnounced = 0;
+
+static void LanSeatsReset()
+{
+	for (int i = 0; i < MAX_PLAYERS; i++)
+		nLanSeat[i] = -1;
+	nLanSeat[0] = 0;
+	nLanSeatsAnnounced = 1;
+}
+
+static void LanSeatComers()
+{
+	// The seats fill from player 1 up and are never given up: the first free
+	// one, and the ports that sit before it. With every seat taken no port is
+	// read here at all.
+	const int nSeats = (int)nMaxPlayers < MAX_PLAYERS ? (int)nMaxPlayers : MAX_PLAYERS;
+	UINT32 nSeated = 1;
+	int nFree = 1;
+	for (; nFree < nSeats && nLanSeat[nFree] >= 0; nFree++)
+		nSeated |= 1u << nLanSeat[nFree];
+
+	const int nCome = (1 << RETRO_DEVICE_ID_JOYPAD_SELECT) | (1 << RETRO_DEVICE_ID_JOYPAD_START);
+	for (int port = 1; port < MAX_PLAYERS && nFree < nSeats; port++) {
+		if (nSeated & (1u << port))
+			continue;
+		int nPressed;
+		if (bLibretroSupportsBitmasks) {
+			if (nLibretroInputBitmask[port] == -1)
+				nLibretroInputBitmask[port] = input_cb(port, RETRO_DEVICE_JOYPAD, 0, RETRO_DEVICE_ID_JOYPAD_MASK);
+			nPressed = nLibretroInputBitmask[port] & nCome;
+		} else {
+			nPressed = input_cb(port, RETRO_DEVICE_JOYPAD, 0, RETRO_DEVICE_ID_JOYPAD_SELECT)
+			        || input_cb(port, RETRO_DEVICE_JOYPAD, 0, RETRO_DEVICE_ID_JOYPAD_START);
+		}
+		if (nPressed)
+			nLanSeat[nFree++] = port;
+	}
+}
