diff --git a/src/burn/devices/epic12.cpp b/src/burn/devices/epic12.cpp
index b018515..c2f5160 100644
--- a/src/burn/devices/epic12.cpp
+++ b/src/burn/devices/epic12.cpp
@@ -422,6 +422,13 @@ void epic12_reset()
 	m_blit_delay_ns = 0;
 	m_blit_idle_op_bytes = 0;
 
+	// OSD/OS's LAN build: the video memory starts empty at every reset, as it
+	// does at power on, once a blit still drawing in its thread is done. Two
+	// machines reset together over the network then fill it alike, as it isn't
+	// in netplay's states (epic12_scan()).
+	thready.notify_wait();
+	memset(m_bitmaps, 0, m_gfx_size * 4);
+
 	thready.reset();
 }
 
@@ -1267,7 +1274,12 @@ void epic12_scan(INT32 nAction, INT32 *pnMin)
 	SCAN_VAR(m_blit_delay_ns);
 	SCAN_VAR(m_blit_idle_op_bytes);
 
-	if (~nAction & ACB_RUNAHEAD) {
+	// OSD/OS's LAN build: nor in netplay's (ACB_NET_OPT), of which RetroArch
+	// keeps a ring of over a hundred, a frame each, 128 MiB apiece with it.
+	// The game's CPU never reads it back (epic12_blitter_read()), and the
+	// blitter's timing is the operations', not their pixels', so the game
+	// runs alike without it; the picture is drawn again as the game goes on.
+	if (!(nAction & (ACB_RUNAHEAD | ACB_NET_OPT))) {
 		ScanVar(m_bitmaps, m_gfx_size * 4, "epic12 vram");
 	}
 	thready.scan();
