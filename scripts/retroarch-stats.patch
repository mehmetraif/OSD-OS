+#if defined(__linux__)
+#include <stdio.h>
+#include <glob.h>
+#endif
+
+/* OSD/OS: the machine's state after the frame rate (osdos_system_show):
+ * the CPU load of all cores over the last update interval (/proc/stat),
+ * the first thermal zone's temperature and a mark while the Raspberry Pi's
+ * firmware reports under-voltage or throttling now (its get_throttled
+ * node: soc/soc:firmware's on a Pi 4, under the soc's address on a Pi 5,
+ * looked for once), read when the frame rate is (update), kept between.
+ * A file that can't be read leaves its part out. Linux only: elsewhere
+ * nothing. */
+static size_t video_driver_osdos_system(char *s, size_t len, bool update)
+{
+   static char text[64];
+   size_t _len = 0;
+#if defined(__linux__)
+   if (update)
+   {
+      static char throttled[192];
+      static bool looked;
+      static unsigned long long last_busy, last_total;
+      unsigned long long v[8] = {0};
+      unsigned i;
+      int zone;
+      unsigned flags;
+      FILE *file;
+      size_t at = 0;
+
+      text[0] = '\0';
+      if ((file = fopen("/proc/stat", "r")))
+      {
+         if (fscanf(file, "cpu %llu %llu %llu %llu %llu %llu %llu %llu",
+                  &v[0], &v[1], &v[2], &v[3], &v[4], &v[5], &v[6], &v[7]) >= 4)
+         {
+            unsigned long long total = 0;
+            unsigned long long busy;
+            for (i = 0; i < 8; i++)
+               total += v[i];
+            busy = total - v[3] - v[4];
+            if (last_total && total > last_total && busy >= last_busy)
+               at += snprintf(text + at, sizeof(text) - at, " | CPU: %u%%",
+                     (unsigned)((200 * (busy - last_busy) + (total - last_total))
+                     / (2 * (total - last_total))));
+            last_busy  = busy;
+            last_total = total;
+         }
+         fclose(file);
+      }
+      for (zone = 0; zone < 10; zone++)
+      {
+         char path[64];
+         long milli;
+         int got;
+         snprintf(path, sizeof(path), "/sys/class/thermal/thermal_zone%d/temp", zone);
+         if (!(file = fopen(path, "r")))
+            continue;
+         got = fscanf(file, "%ld", &milli);
+         fclose(file);
+         if (got == 1)
+         {
+            if (at < sizeof(text))
+               at += snprintf(text + at, sizeof(text) - at, " | %ldC",
+                     (milli + (milli < 0 ? -500 : 500)) / 1000);
+            break;
+         }
+      }
+      if (!looked)
+      {
+         glob_t found;
+         memset(&found, 0, sizeof(found));
+         looked = true;
+         if (glob("/sys/devices/platform/soc*/soc*:firmware/get_throttled", 0, NULL, &found) == 0
+               && found.gl_pathc > 0)
+            strlcpy(throttled, found.gl_pathv[0], sizeof(throttled));
+         globfree(&found);
+      }
+      if (throttled[0] && (file = fopen(throttled, "r")))
+      {
+         if (fscanf(file, "%x", &flags) == 1)
+         {
+            if ((flags & 0x1) && at < sizeof(text))
+               at += snprintf(text + at, sizeof(text) - at, " | UNDERVOLT");
+            if ((flags & 0xE) && at < sizeof(text))
+               at += snprintf(text + at, sizeof(text) - at, " | THROTTLED");
+         }
+         fclose(file);
+      }
+   }
+#endif
+   if (len > 0)
+   {
+      _len = strlcpy(s, text, len);
+      if (_len >= len)
+         _len = len - 1;
+   }
+   return _len;
+}
