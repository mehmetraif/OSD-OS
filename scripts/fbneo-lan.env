# The FinalBurn Neo commit OSD/OS's CV1000 LAN core is built from, which
# scripts/fbneo-lan.patch is made against, and the commit's date (yymmdd),
# which the core's version is made of (scripts/build-fbneo-lan.sh). Every
# package's core is built from this one, so that the machines of a release
# play the same core over the local network. Read by the script and by the
# workflows that fetch the source (.github/actions/fbneo-lan-core,
# freebsd.yml, openbsd.yml).
FBNEO_LAN_COMMIT=2b0c1c0679df115cada7df9199ea2762222e58fd
FBNEO_LAN_DATE=261021
