# What scripts/install.sh installs on Raspberry Pi OS Lite, less qt6-wayland
# (desktop sessions only) and plus alsa-utils. Without recommends, so mpv doesn't drag in xdg-utils
# and friends.
libqt6quick6 libqt6qml6 libqt6opengl6 libqt6network6 libqt6svg6 qt6-svg-plugins
qml6-module-qtquick qml6-module-qtquick-controls qml6-module-qtquick-window
libsdl2-2.0-0 libpcsclite1
mpv
libmpv2
alsa-utils
# The menu music's MIDI files, which FluidSynth plays with a small General
# MIDI SoundFont, and openmpt123 for a tracker's module (XM, MOD, S3M, IT)
# where mpv's ffmpeg can't play one itself.
fluidsynth timgm6mb-soundfont openmpt123
# polkitd, which reads the rule that lets the app's user use NetworkManager
# (Settings → Wi-Fi, 02-system). network-manager pulls it in already; named
# so it stays.
polkitd
