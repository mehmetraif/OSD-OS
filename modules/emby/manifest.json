{
  "id": "com.osdos.emby",
  "name": "Emby",
  "menu_order": 50,
  "icon": "assets/images/logo.svg",
  "entry_point_qml": "views/Root.qml",
  "settings_group": "tv",
  "settings": [
    {
      "key": "enabled",
      "label": "Enabled",
      "type": "toggle",
      "default": "OFF"
    },
    {
      "key": "sign_in",
      "label": "Sign In",
      "type": "module_view",
      "account": true,
      "options_source": "dynamic",
      "options_slot": "get_account",
      "description": "Opens Emby to sign in: the server's address and a password, or Emby Connect\nSigned in, the user in use"
    },
    {
      "key": "server_url",
      "label": "Server Address",
      "type": "text",
      "default": "",
      "placeholder": "http://192.168.1.10:8096",
      "max_length": 200,
      "description": "Your Emby server, as http://192.168.1.10:8096\nThe sign-in screen fills it in too"
    },
    {
      "key": "libraries",
      "label": "Libraries",
      "type": "multiselect_submenu",
      "options_source": "dynamic",
      "options_slot": "getLibraries",
      "requires_auth": true
    },
    {
      "key": "video_quality",
      "label": "Video Quality",
      "type": "list_single",
      "options_source": "dynamic",
      "options_slot": "getVideoQualities",
      "default": "auto",
      "requires_auth": true
    },
    {
      "key": "resume_playback",
      "label": "Resume Playback",
      "type": "list_single",
      "options_source": "dynamic",
      "options_slot": "get_resume_playback_options",
      "default": "ask",
      "requires_auth": true
    },
    {
      "key": "autoplay_next_episode",
      "label": "Autoplay Next Episode",
      "type": "toggle",
      "default": "OFF",
      "requires_auth": true
    },
    {
      "key": "intro_skip",
      "label": "Intro Skip",
      "type": "list_single",
      "options": ["Off", "Auto", "Button"],
      "default": "Off",
      "requires_auth": true,
      "description": "Uses Emby's intro chapter markers when the server has detected them"
    },
    {
      "key": "outro_skip",
      "label": "Credit Skip",
      "type": "list_single",
      "options": ["Off", "Auto", "Button"],
      "default": "Off",
      "requires_auth": true,
      "description": "Uses Emby's credit chapter markers when the server has detected them"
    },
    {
      "key": "video_scaling",
      "label": "Scaling",
      "type": "list_single",
      "options": ["Default", "Letterbox", "14:9", "Pan & Scan", "Anamorphic"],
      "default": "Default",
      "description": "How a 16:9 picture fills the 4:3 screen in this module\n[DEFAULT] As Settings' Scaling says"
    },
    {
      "key": "logout",
      "label": "Sign Out",
      "type": "action",
      "action_slot": "logout",
      "confirm": "Sign out of Emby?",
      "done": "Signing out of Emby",
      "description": "Removes this device from the server and forgets the sign-in here",
      "requires_auth": true
    }
  ]
}
