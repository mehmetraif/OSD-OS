{
  "id": "com.osdos.ambient_mode",
  "name": "Ambient:Mode",
  "icon": "assets/images/logo.svg",
  "entry_point_qml": "views/Root.qml",
  "settings_group": "tv",
  "settings": [
    {
      "key": "enabled",
      "label": "ENABLED",
      "type": "toggle",
      "default": "OFF"
    },
    {
      "key": "media_directory",
      "label": "Media Directory",
      "type": "directory_browser",
      "default": ""
    },
    {
      "key": "auto_launch",
      "label": "Auto-Launch Playback",
      "type": "toggle",
      "default": "OFF"
    },
    {
      "key": "video_scaling",
      "label": "Scaling",
      "type": "list_single",
      "options": ["Default", "Letterbox", "14:9", "Pan & Scan", "Anamorphic"],
      "default": "Default",
      "description": "How a 16:9 picture fills the 4:3 screen in this module\n[DEFAULT] As Settings' Scaling says"
    }
  ]
}
